#!/usr/bin/env bash
# Fake `gh` for offline Define tests. State lives in $FAKE_GH_DIR (default ./.fake-gh).
# Logs every call to calls.log; stores issues and comments as files.
d=${FAKE_GH_DIR:-.fake-gh}; mkdir -p "$d/issues"
echo "gh $*" >> "$d/calls.log"
case "$1 $2" in
  "repo view") echo '{"nameWithOwner":"fake/define-sandbox","visibility":"PRIVATE"}' ;;
  "issue create")
    n=$(( $(ls "$d/issues" | grep -c '^[0-9]*$') + 1 )); mkdir -p "$d/issues/$n"
    shift 2; while [ $# -gt 0 ]; do case $1 in
      --title) echo "$2" > "$d/issues/$n/title"; shift 2;;
      --body-file) cp "$2" "$d/issues/$n/body"; shift 2;;
      --label) echo "$2" >> "$d/issues/$n/labels"; shift 2;;
      *) shift;; esac; done
    echo "https://github.com/fake/define-sandbox/issues/$n" ;;
  "issue comment")
    n=${3#\#}; mkdir -p "$d/issues/$n"; cat > "$d/issues/$n/comment.$(date +%s%N)" ;;
  "issue edit")
    n=${3#\#}; shift 3; while [ $# -gt 0 ]; do case $1 in
      --body-file) cp "$2" "$d/issues/$n/body"; shift 2;;
      --add-label) echo "$2" >> "$d/issues/$n/labels"; shift 2;;
      *) shift;; esac; done ;;
  "issue view")
    n=${3#\#}; python3 - "$d/issues/$n" <<'PY'
import sys,json,glob,os
p=sys.argv[1]; rd=lambda f: open(os.path.join(p,f)).read() if os.path.exists(os.path.join(p,f)) else ""
print(json.dumps({"title":rd("title").strip(),"body":rd("body"),
 "labels":[{"name":l} for l in rd("labels").split()],
 "comments":[{"body":open(c).read()} for c in sorted(glob.glob(p+"/comment.*"))]}))
PY
    ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
